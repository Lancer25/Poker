}
.seat.active .avatar {
  border-color: #71d3b9;
  box-shadow: 0 0 0 6rpx #71d3b924;
}
.seat.winner .name,
.seat.winner .stack {
  border-color: #ebcc83;
  background: #38392a;
}
.seat.winner .avatar {
  border-color: #ebcc83;
}
.seat-clock:not(.urgent) {
  color: #142a22;
  background: #73cdb5;
  border-color: #99e1ca;
}
.turn-notice.your-turn {
  color: #71d3b9;
}
.effect-deal .card,
.effect-board .center .card {
  animation: table-deal 0.3s ease-out;
}
.effect-chip .pot {
  animation: pot-feedback 0.3s ease-out;
}
.effect-win .payout {
  animation: table-deal 0.25s ease-out;
}
.motion-off .card,
.motion-off .pot,
.motion-off .payout,
.motion-off .seat-clock {
  animation: none !important;
}
@keyframes table-deal {
  from {
    opacity: 0.3;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes pot-feedback {
  from {
    transform: scale(0.97);
  }
  to {
    transform: scale(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .card,
  .pot,
  .payout,
  .seat-clock {
    animation: none !important;
  }
}
.manual-raise .raise-field {
