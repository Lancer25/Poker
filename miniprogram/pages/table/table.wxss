}
.winner-presenting .center { visibility: hidden; }
.winner-focus { position: absolute; left: 14%; top: 50%; transform: translateY(-50%); z-index: 8; width: 72%; max-height: 74%; overflow: auto; box-sizing: border-box; padding: 20rpx; border: 1px solid #d8bb6b; border-radius: 8px; background: #0b2927; text-align: center; }
