.dice-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.dice-pair { display: flex; flex: 0 0 128rpx; gap: 12rpx; }
.dice-pair image { width: 56rpx; height: 56rpx; border-radius: 4px; background: #f5faf7; }
.friend-manager { padding-bottom: 24rpx; margin-bottom: 24rpx; border-bottom: 1px solid #ffffff24; }
.member-row { display: flex; gap: 20rpx; align-items: center; min-height: 88rpx; font-size: 24rpx; }
