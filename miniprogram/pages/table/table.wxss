  width: 36rpx;
  height: 36rpx;
}
.experience-settings {
  padding: 24rpx 0;
  border-top: 1px solid #ffffff18;
  border-bottom: 1px solid #ffffff18;
}
.experience-settings > view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}
.experience-settings slider {
  width: 330rpx;
}
.bet-presets {
  display: flex;
  gap: 8rpx;
  margin: 12rpx 0;
}
.bet-presets button {
  flex: 1;
  min-width: 0;
  padding: 4rpx;
  font-size: 22rpx;
  line-height: 64rpx;
