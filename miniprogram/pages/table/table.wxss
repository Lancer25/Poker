.member-row image { width: 36rpx; height: 36rpx; display: block; filter: invert(.85); }
.player-overlay { position: fixed; inset: 0; z-index: 1000; background: #0009; display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.player-dialog { width: 100%; max-width: 720rpx; max-height: 85vh; overflow-y: auto; padding: 32rpx; box-sizing: border-box; border: 1px solid #536761; border-radius: 8px; background: #172523; }
