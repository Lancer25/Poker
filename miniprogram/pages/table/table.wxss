  line-height: 1.8;
}
.insight-note {
  margin-top: 8rpx;
  color: #8da49a;
  font-size: 22rpx;
}
.settings-button {
  padding: 0 !important;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tool-scroll {
  height: 680rpx;
}
.rematch-controls {
  margin-top: 20rpx;
}
.rematch-controls .mode-picker {
  margin: 12rpx 0;
}
