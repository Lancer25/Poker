# Copy locally to .env, then: node --env-file=.env server/index.js
# Never commit .env or bootstrap credentials.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
ROOM_STORAGE=json
BACKUP_INTERVAL_MS=21600000
BACKUP_KEEP=14
REQUIRE_SECURE_AUTH=0
# PUBLIC_HTTPS_URL=https://your-domain.example
# BACKUP_DIR=/absolute/private/backup/directory
